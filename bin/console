#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "solidgate-ruby-sdk"
require "pry"

Solidgate.configure do |config|
  config.public_key = ENV['SOLIDGATE_PUBLIC_KEY'] || "your_public_key"
  config.private_key = ENV['SOLIDGATE_PRIVATE_KEY'] || "your_private_key"
  config.sandbox = true
end
Pry.start
